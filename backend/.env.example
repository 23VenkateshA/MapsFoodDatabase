# LLM provider key - the API calls OpenRouter (https://openrouter.ai), which is
# OpenAI-API-compatible and can route to many providers/models via one key.
# If unset, POST /chat runs in offline mode with a rule-based keyword matcher
# (this is the same behavior the original Streamlit app had, not an error state).
OPENROUTER_API_KEY=

# Comma-separated list of origins allowed to call this API (CORS).
# Include your local Next.js dev server and your Vercel deployment URL.
ALLOWED_ORIGINS=http://localhost:3000

# Path to the SQLite file used for session-scoped bookmarks/itinerary/imported-dataset
# storage. Defaults to ./data/app.db if unset.
DATABASE_PATH=./data/app.db
