# LLM provider keys - the app uses OpenAI if present, otherwise falls back to Anthropic.
# If neither is set, the app runs in offline mode with a rule-based keyword matcher.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional - used only by enrich_places.py to fetch real metadata.
# If unset, enrich_places.py generates reasonable offline fallback metadata.
GOOGLE_PLACES_API_KEY=
