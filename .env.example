# LLM provider key - the app calls OpenRouter (https://openrouter.ai), which is
# OpenAI-API-compatible and can route to many providers/models via one key.
# If unset, the app runs in offline mode with a rule-based keyword matcher.
OPENROUTER_API_KEY=

# Optional - used only by enrich_places.py to fetch real metadata.
# If unset, enrich_places.py generates reasonable offline fallback metadata.
GOOGLE_PLACES_API_KEY=
